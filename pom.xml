<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.2.0</version>
    <relativePath/>
  </parent>

  <groupId>com.joedayz.springai</groupId>
  <artifactId>springai-course</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <java.version>25</java.version>
    <spring-ai.version>2.1.0</spring-ai.version>
  </properties>

  <modules>
    <module>m01-primer-chat</module>
    <module>m02-chatclient</module>
    <module>m03-salidas-estructuradas</module>
    <module>m04-memoria-advisors</module>
    <module>m05-rag</module>
    <module>m06-tool-calling</module>
    <module>m07-mcp-server</module>
    <module>m07-mcp-client-agentes</module>
    <module>m08-multimodal</module>
    <module>m09-produccion</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
